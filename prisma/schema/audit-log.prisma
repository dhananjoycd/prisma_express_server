model AuditLog {
    id         String   @id @default(uuid())
    actorId    String?
    actorRole  String?
    action     String
    entityType String
    entityId   String?
    metadata   Json?
    createdAt  DateTime @default(now())

    actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

    @@index([actorId])
    @@index([action])
    @@index([entityType])
    @@index([createdAt])
}
